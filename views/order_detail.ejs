<!DOCTYPE html>
<html lang="uk">
<head>
  <meta charset="utf-8">
  <title>Накладна - WMS</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <nav><a href="/">Головна</a> | <a href="/orders">Накладні</a></nav>
  <h1>Накладна <%= order.order_number %></h1>
  <p>Постачальник: <%= order.supplier %> | Дата: <%= new Date(order.supply_date).toLocaleString('uk-UA') %> | Статус: <%= order.status %> | Сума: <%= order.total_cost %></p>
  <h2>Позиції</h2>
  <table>
    <thead><tr><th>Товар</th><th>Комірка</th><th>Кількість</th><th>Ціна</th><th>Партія</th><th>Термін</th><th>Дії</th></tr></thead>
    <tbody>
      <% if (items.length === 0) { %><tr><td colspan="7">Немає позицій</td></tr><% } %>
      <% items.forEach(it => { %>
        <tr>
          <td><%= it.sku_code %> - <%= it.name %></td>
          <td><%= it.location_code %></td>
          <td><%= it.quantity %></td>
          <td><%= it.unit_price %></td>
          <td><%= it.batch_number %></td>
          <td><%= it.expiry_date ? new Date(it.expiry_date).toLocaleDateString('uk-UA') : '' %></td>
          <td>
            <% if (order.status === 'draft') { %>
              <form method="post" action="/orders/<%= order.order_id %>/items/<%= it.product_id %>/delete" style="display:inline" onsubmit="return confirm('Видалити позицію?')">
                <button type="submit">Видалити</button>
              </form>
            <% } %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  <% if (order.status === 'draft') { %>
    <p>
      <a class="btn" href="/orders/<%= order.order_id %>/items/new">+ Додати позицію</a>
      <form method="post" action="/orders/<%= order.order_id %>/receive" style="display:inline">
        <button type="submit">Оприбуткувати</button>
      </form>
      <form method="post" action="/orders/<%= order.order_id %>/cancel" style="display:inline">
        <button type="submit">Скасувати</button>
      </form>
    </p>
  <% } %>
  <% if (order.status !== 'received') { %>
    <form method="post" action="/orders/<%= order.order_id %>/delete" style="display:inline" onsubmit="return confirm('Видалити накладну?')">
      <button type="submit">Видалити</button>
    </form>
  <% } %>
  <p><a href="/orders">Назад</a></p>
</body>
</html>