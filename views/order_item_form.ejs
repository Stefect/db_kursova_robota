<!DOCTYPE html>
<html lang="uk">
<head>
  <meta charset="utf-8">
  <title>Позиція накладної - WMS</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <nav><a href="/">Головна</a> | <a href="/orders">Накладні</a></nav>
  <h1>Додати позицію до накладної</h1>
  <% if (error) { %><p class="error"><%= error %></p><% } %>
  <form method="post" action="/orders/<%= order_id %>/items">
    <label>Товар *
      <select name="product_id" required>
        <% products.forEach(p => { %>
          <option value="<%= p.product_id %>"><%= p.sku_code %> - <%= p.name %></option>
        <% }) %>
      </select>
    </label>
    <label>Комірка приймання *
      <select name="location_id" required>
        <% locations.forEach(l => { %>
          <option value="<%= l.location_id %>"><%= l.location_code %></option>
        <% }) %>
      </select>
    </label>
    <label>Кількість * <input name="quantity" type="number" min="1" required value="<%= values.quantity || 1 %>"></label>
    <label>Ціна за одиницю * <input name="unit_price" type="number" step="0.01" min="0" required value="<%= values.unit_price || 0 %>"></label>
    <label>Партія * <input name="batch_number" required maxlength="50" value="<%= values.batch_number || '' %>"></label>
    <label>Термін придатності <input name="expiry_date" type="date" value="<%= values.expiry_date || '' %>"></label>
    <button type="submit">Додати</button>
  </form>
  <p><a href="/orders/<%= order_id %>">Назад</a></p>
</body>
</html>